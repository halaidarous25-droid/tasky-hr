# =====================================================
# Firebase Configuration
# Copy this file to .env and fill in your values
# cp .env.example .env
# =====================================================
# Get these from Firebase Console:
# https://console.firebase.google.com → Project Settings → Your Apps → Web App

VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx

# ─── Without Firebase (local mode) ───────────────────────────
# Leave the above values empty or as-is to run in localStorage mode
# All data will be saved locally in the browser only
